# ── Cloudflare R2 (files + job records) ──────────────────────────────
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# R2 bucket name (must match the bucket you created in Cloudflare)
R2_BUCKET_NAME=print-jobs

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Include your client site(s) so the browser can reach this API.
# Example: https://cusheetgenerator.com,https://www.cusheetgenerator.com,https://cuprint.vercel.app
CORS_ORIGIN=

# ── Optional ─────────────────────────────────────────────────────────
# Set to "0" to disable demo print jobs on first run.
DEMO_FILES=0

# 6-digit PIN for shop registration (default: 542004).
SHOP_SETUP_PIN=542004

# Wallet default balance (₹1 = 1 point, default 100000).
WALLET_DEFAULT_BALANCE=100000
