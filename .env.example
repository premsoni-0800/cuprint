# ── Cloudflare R2 (everything — files + job records) ────────────────────────
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token
# (Object Read & Write on the bucket). ACCOUNT_ID is the 32-hex account id
# from the R2 overview page.
#
# The whole print pipeline runs on Cloudflare R2 — no separate database
# needed:
#   • uploaded files → <bucket>/<storagePath>
#   • job records    → <bucket>/jobs/<id>.json
# Copy this file to `.env` at the repo root (the server loads it on start).

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=print-jobs

# ── API behaviour ────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins allowed to call the API (CORS).
# Leave unset to allow any origin (fine for local dev). Include every origin
# that calls the API: the main site, the deployed dashboard, and localhost
# dev servers (the browser blocks cross-origin calls without this).
CORS_ORIGIN=https://cusheetgenerator.com,https://www.cusheetgenerator.com,http://localhost:3000,http://localhost:5173,https://shop-dashboard-eight-khaki.vercel.app

# Set to 0 to skip seeding demo jobs on an empty bucket.
DEMO_FILES=0
